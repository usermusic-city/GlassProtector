<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- DPT加固说明卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_dpt"
                        android:contentDescription="DPT" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="DPT 函数抽取壳"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="魔改版"
                        android:textColor="@color/glass_warning"
                        android:textSize="11sp"
                        android:background="@drawable/glass_tag_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/dpt_desc"
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 选择APK卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_apk"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/dpt_apkInfoLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/glass_spinner_bg"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/dpt_apkName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:ellipsize="middle"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/dpt_apkSize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/glass_text_hint"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/dpt_selectApkBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/select_apk"
                    style="@style/GlassButton" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 加固强度卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/protect_level"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- 强度选择 RadioGroup -->
                <RadioGroup
                    android:id="@+id/dpt_levelGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/dpt_levelLow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="@string/level_low"
                        android:textColor="@color/glass_text_secondary"
                        android:textSize="13sp"
                        android:buttonTint="@color/glass_primary" />

                    <RadioButton
                        android:id="@+id/dpt_levelMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="@string/level_medium"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="13sp"
                        android:buttonTint="@color/glass_primary"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/dpt_levelHigh"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="@string/level_high"
                        android:textColor="@color/glass_text_secondary"
                        android:textSize="13sp"
                        android:buttonTint="@color/glass_primary" />
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 加固选项卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/options"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/dpt_optMethodExtract"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/opt_method_extract"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="13sp"
                    android:checked="true"
                    app:thumbTint="@color/glass_primary"
                    app:trackTint="@color/glass_card_border" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/dpt_optStringEncrypt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/opt_string_encrypt"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="13sp"
                    android:checked="true"
                    app:thumbTint="@color/glass_primary"
                    app:trackTint="@color/glass_card_border" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/dpt_optAntiDebug"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/opt_anti_debug"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="13sp"
                    android:checked="false"
                    app:thumbTint="@color/glass_primary"
                    app:trackTint="@color/glass_card_border" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/dpt_optSignVerify"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/opt_sign_verify"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="13sp"
                    android:checked="false"
                    app:thumbTint="@color/glass_primary"
                    app:trackTint="@color/glass_card_border" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/dpt_optJunkCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/opt_junk_code"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="13sp"
                    android:checked="false"
                    app:thumbTint="@color/glass_primary"
                    app:trackTint="@color/glass_card_border" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 高级防护卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="高级防护"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/dpt_optDex2c"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Dex2C（Java方法转C Native）"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="13sp"
                    android:checked="false"
                    app:thumbTint="@color/glass_primary"
                    app:trackTint="@color/glass_card_border" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/dpt_optAssetsEncrypt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="assets资源加密"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="13sp"
                    android:checked="false"
                    app:thumbTint="@color/glass_primary"
                    app:trackTint="@color/glass_card_border" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/dpt_optRuneObfuscate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="卢恩字符混淆（类名/方法名）"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="13sp"
                    android:checked="false"
                    app:thumbTint="@color/glass_primary"
                    app:trackTint="@color/glass_card_border" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 开始加固按钮 -->
        <Button
            android:id="@+id/dpt_startProtectBtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="@string/start_protect"
            android:textSize="16sp"
            android:textStyle="bold"
            style="@style/GlassButton" />

    </LinearLayout>
</ScrollView>
