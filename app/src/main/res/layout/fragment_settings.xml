<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 页面标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="设置"
            android:textColor="@color/glass_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- 签名秘钥配置 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="签名秘钥"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="导入自定义签名秘钥（支持 .jks / .bks 格式）"
                    android:textColor="@color/glass_text_hint"
                    android:textSize="12sp" />

                <!-- 已导入秘钥信息 -->
                <LinearLayout
                    android:id="@+id/keystoreInfoLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/glass_spinner_bg"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/keystoreFileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/keystoreAlias"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/glass_text_hint"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/importKeystoreBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="导入秘钥文件"
                    style="@style/GlassButton" />

                <!-- 秘钥密码输入 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/keystorePassLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="秘钥密码"
                    android:textColorHint="@color/glass_text_hint"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/glass_card_border"
                    app:hintTextColor="@color/glass_text_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/keystorePassEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 别名输入 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/keystoreAliasLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="密钥别名 (Alias)"
                    android:textColorHint="@color/glass_text_hint"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/glass_card_border"
                    app:hintTextColor="@color/glass_text_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/keystoreAliasEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 导出目录配置 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="导出目录"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="加固后APK的保存位置"
                    android:textColor="@color/glass_text_hint"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/glass_spinner_bg"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/outputDirText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/resetOutputDirBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="恢复默认"
                        android:textSize="13sp"
                        style="@style/GlassButton" />

                    <Button
                        android:id="@+id/chooseOutputDirBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="选择目录"
                        android:textSize="13sp"
                        style="@style/GlassButton" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 其他设置 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="通用设置"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/autoSignSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="加固后自动签名"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="13sp"
                    android:checked="true"
                    app:thumbTint="@color/glass_primary"
                    app:trackTint="@color/glass_card_border" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/keepOriginalSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="保留原APK备份"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="13sp"
                    android:checked="true"
                    app:thumbTint="@color/glass_primary"
                    app:trackTint="@color/glass_card_border" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/showLogSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="显示详细加固日志"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="13sp"
                    android:checked="false"
                    app:thumbTint="@color/glass_primary"
                    app:trackTint="@color/glass_card_border" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
